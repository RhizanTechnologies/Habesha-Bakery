// Habesha Bakery ERP - Foundation Schema
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  BRANCH_MANAGER
  CASHIER
  STOREKEEPER
  PRODUCTION_SUPERVISOR
  BAKER
  DRIVER
}

enum Shift {
  DAY
  NIGHT
}

enum PaymentMethod {
  CASH
  CBE
  TELEBIRR
  MOBILE_BANKING
  CREDIT
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
}

model Branch {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String   @unique // "BOLE-HUB", "MEG", "PIA", "SAR", "CMC"
  isHub       Boolean  @default(false)
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  productStocks      BranchProductStock[]
  sales              Sale[]
  dailyCashTrackings DailyCashTracking[]

  @@index([companyId])
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  phone        String    @unique // Phone used as login username
  passwordHash String
  role         Role
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  salary       Decimal?  @db.Decimal(12, 2)
  shift        Shift?
  avatarUrl    String?
  filesUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  passwordResetRequests PasswordResetRequest[]
  sales                 Sale[]
  dailyCashTrackings    DailyCashTracking[]

  @@index([branchId])
  @@index([role])
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Product {
  id           String             @id @default(cuid())
  categoryId   String
  category     ProductCategory    @relation(fields: [categoryId], references: [id])
  name         String
  sku          String             @unique
  sellingPrice Decimal            @db.Decimal(10, 2)
  costPrice    Decimal?           @db.Decimal(10, 2)
  unit         String             @default("PIECE")
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  branchStocks BranchProductStock[]
  saleItems    SaleItem[]

  @@index([categoryId])
}

model BranchProductStock {
  id             String   @id @default(cuid())
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  availableStock Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  branchId  String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([branchId])
}

enum ResetRequestStatus {
  PENDING
  RESOLVED
  REJECTED
}

model PasswordResetRequest {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String
  status           ResetRequestStatus @default(PENDING)
  requestedAt      DateTime           @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  @@index([userId])
  @@index([status])
}

// ─── DEVELOPER 2: SALES, POS & CASH TRACKING ────────────────────────────────

model Sale {
  id            String        @id @default(cuid())
  receiptNumber String        @unique // e.g. "REC-MEG-20261030-0001"
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierId     String
  cashier       User          @relation(fields: [cashierId], references: [id])
  businessDate  String        // "YYYY-MM-DD"
  paymentMethod PaymentMethod @default(CASH)
  totalAmount   Decimal       @db.Decimal(10, 2)
  customerName  String?
  customerPhone String?
  items         SaleItem[]
  createdAt     DateTime      @default(now())

  @@index([branchId])
  @@index([cashierId])
  @@index([businessDate])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)

  @@index([saleId])
  @@index([productId])
}

model DailyCashTracking {
  id                String   @id @default(cuid())
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  businessDate      String   // "YYYY-MM-DD"
  startingFloat     Decimal  @default(0) @db.Decimal(10, 2)
  totalCashSales    Decimal  @default(0) @db.Decimal(10, 2)
  totalDigitalSales Decimal  @default(0) @db.Decimal(10, 2)
  totalExpenses     Decimal  @default(0) @db.Decimal(10, 2)
  expectedCash      Decimal  @db.Decimal(10, 2)
  actualCountedCash Decimal  @db.Decimal(10, 2)
  variance          Decimal  @db.Decimal(10, 2) // actualCountedCash - expectedCash
  submittedByUserId String
  submittedByUser   User     @relation(fields: [submittedByUserId], references: [id])
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([branchId, businessDate])
  @@index([branchId])
  @@index([businessDate])
}
