datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  BRANCH_MANAGER
  CASHIER
  STOREKEEPER
  PRODUCTION_SUPERVISOR
  BAKER
  DRIVER
}

enum Shift {
  DAY
  NIGHT
}

enum PaymentMethod {
  CASH
  CBE
  TELEBIRR
  MOBILE_BANKING
  CREDIT
}

enum BatchStatus {
  MIXING
  BAKING
  COMPLETED
}

enum TransferStatus {
  PENDING_DISPATCH
  IN_TRANSIT
  RECEIVED
  REJECTED
}

enum ResetRequestStatus {
  PENDING
  RESOLVED
  REJECTED
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
}

model Branch {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String   @unique // "BOLE-HUB", "MEG", "PIA", "SAR", "CMC"
  isHub       Boolean  @default(false)
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  productStocks      BranchProductStock[]
  rawMaterialStocks  RawMaterialStock[]
  disbursementsFrom  MaterialDisbursement[]
  productionBatches  ProductionBatch[]
  outboundTransfers  TransferManifest[]     @relation("SourceBranchTransfers")
  inboundTransfers   TransferManifest[]     @relation("DestBranchTransfers")

  @@index([companyId])
}

model User {
  id                      String    @id @default(cuid())
  fullName                String
  phone                   String    @unique // Phone used as login username
  passwordHash            String
  pinHash                 String?   // 4-digit fast tablet unlock PIN
  managerApprovalPinHash  String?   // 6-digit supervisor authorization code
  role                    Role
  branchId                String?
  branch                  Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive                Boolean   @default(true)
  salary                  Decimal?  @db.Decimal(12, 2)
  shift                   Shift?
  avatarUrl               String?
  filesUrl                String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  passwordResetRequests   PasswordResetRequest[]
  disbursements           MaterialDisbursement[]
  productionBatches       ProductionBatch[]
  driverTransfers         TransferManifest[]      @relation("DriverTransfers")
  receivedTransfers       TransferManifest[]      @relation("ReceivedTransfers")

  @@index([branchId])
  @@index([role])
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Product {
  id           String             @id @default(cuid())
  categoryId   String
  category     ProductCategory    @relation(fields: [categoryId], references: [id])
  name         String
  sku          String             @unique
  sellingPrice Decimal            @db.Decimal(10, 2)
  costPrice    Decimal?           @db.Decimal(10, 2)
  unit         String             @default("PIECE")
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  branchStocks      BranchProductStock[]
  productionBatches ProductionBatch[]
  transferManifests TransferManifest[]

  @@index([categoryId])
}

model BranchProductStock {
  id             String   @id @default(cuid())
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  availableStock Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

// ── Developer 1: Raw Materials & Hub Warehouse ──────────────────────

model RawMaterial {
  id                 String   @id @default(cuid())
  name               String   @unique // e.g. "Wheat Flour (50kg Bag)", "Dry Yeast", "White Sugar"
  sku                String   @unique
  unit               String   @default("KG") // "BAG", "KG", "LITER"
  packageWeightKg    Decimal? @default(50.0) @db.Decimal(10, 2)
  minStockThreshold  Decimal  @default(10.0) @db.Decimal(10, 2)
  costPerUnit        Decimal? @db.Decimal(10, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stocks             RawMaterialStock[]
  disbursementItems  MaterialDisbursementItem[]
}

model RawMaterialStock {
  id            String      @id @default(cuid())
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  quantity      Decimal     @default(0) @db.Decimal(12, 2)
  updatedAt     DateTime    @updatedAt

  @@unique([branchId, rawMaterialId])
  @@index([branchId])
}

model MaterialDisbursement {
  id                String                     @id @default(cuid())
  fromBranchId      String
  fromBranch        Branch                     @relation(fields: [fromBranchId], references: [id], onDelete: Cascade)
  disbursedByUserId String
  disbursedByUser   User                       @relation(fields: [disbursedByUserId], references: [id], onDelete: Restrict)
  department        String                     @default("KITCHEN")
  notes             String?
  createdAt         DateTime                   @default(now())

  items             MaterialDisbursementItem[]

  @@index([fromBranchId])
  @@index([createdAt])
}

model MaterialDisbursementItem {
  id             String               @id @default(cuid())
  disbursementId String
  disbursement   MaterialDisbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  rawMaterialId  String
  rawMaterial    RawMaterial          @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  quantity       Decimal              @db.Decimal(10, 2)
  unit           String

  @@index([disbursementId])
}

// ── Developer 1: Baking Engine & 1,362 Loaf Yield Physics ───────────

model ProductionBatch {
  id                  String      @id @default(cuid())
  batchNumber         String      @unique // e.g. "BATCH-20261027-001"
  branchId            String
  branch              Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bakerId             String
  baker               User        @relation(fields: [bakerId], references: [id], onDelete: Restrict)
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  flourSacksUsed      Decimal     @db.Decimal(10, 2) // e.g. 4.0 sacks
  flourWeightKg       Decimal     @db.Decimal(10, 2) // e.g. 200.0 kg
  expectedLoaves      Int         // flourSacksUsed * 1362
  actualLoavesBaked   Int         // e.g. 5448
  damagedLoaves       Int         @default(0)
  yieldEfficiency     Decimal     @db.Decimal(6, 2) // (actualLoavesBaked / expectedLoaves) * 100
  isFlagged           Boolean     @default(false)   // flagged if yield < 90%
  flagReason          String?
  status              BatchStatus @default(COMPLETED)
  shift               Shift       @default(DAY)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([branchId])
  @@index([bakerId])
  @@index([createdAt])
}

// ── Developer 1: Crate Logistics & Driver Delivery Handshake ────────

model TransferManifest {
  id                       String         @id @default(cuid())
  manifestNumber           String         @unique // e.g. "TRF-20261027-001"
  sourceBranchId           String         // Central Hub
  sourceBranch             Branch         @relation("SourceBranchTransfers", fields: [sourceBranchId], references: [id], onDelete: Cascade)
  destinationBranchId      String         // Retail Spoke
  destinationBranch        Branch         @relation("DestBranchTransfers", fields: [destinationBranchId], references: [id], onDelete: Cascade)
  productId                String
  product                  Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  dispatchedLoaves         Int
  crateCount               Int            // Math.ceil(dispatchedLoaves / 40)
  driverId                 String
  driver                   User           @relation("DriverTransfers", fields: [driverId], references: [id], onDelete: Restrict)
  status                   TransferStatus @default(PENDING_DISPATCH)
  dispatchedAt             DateTime?
  driverSignedAt           DateTime?
  receivedLoaves           Int?
  crushedLoaves            Int?           @default(0)
  driverBilledCost         Decimal?       @default(0) @db.Decimal(10, 2)
  receivedByUserId         String?
  receivedByUser           User?          @relation("ReceivedTransfers", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  receivedAt               DateTime?
  supervisorCodeVerified   Boolean        @default(false)
  notes                    String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@index([driverId])
  @@index([status])
}

// ── Shared Models ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  branchId  String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([branchId])
}

model PasswordResetRequest {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String
  status           ResetRequestStatus @default(PENDING)
  requestedAt      DateTime           @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  @@index([userId])
  @@index([status])
}
